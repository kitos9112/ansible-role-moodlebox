#!/usr/bin/env bash

set -euo pipefail

cd "{{ moodlebox_certbot_dir }}"

ETC="$(pwd)/etc"
LIB="$(pwd)/lib"
LOG="$(pwd)/log"
mkdir -p "$ETC" "$LIB" "$LOG"

COMMAND="${1:-}"
case "$COMMAND" in
  certonly|renew) ;;
  *)
    printf >&2 'Usage: %s <certonly|renew>\n' "$0"
    exit 1
    ;;
esac

docker rm -f certbot-moodlebox >/dev/null 2>&1 || true

docker run --rm --name certbot-moodlebox \
   -v "$ETC:/etc/letsencrypt:rw" \
   -v "$LIB:/var/lib/letsencrypt:rw" \
   -v "$LOG:/var/log/letsencrypt:rw" \
   "{{ moodlebox_certbot_cf_repo }}" \
   --dns-cloudflare \
   --dns-cloudflare-credentials /etc/letsencrypt/cf.ini \
   --dns-cloudflare-propagation-seconds 30 \
   --non-interactive \
   --agree-tos \
   --email "{{ moodlebox_cf_email_address | default(cloudflare_account_email | default('')) }}" \
   "$COMMAND" \
   -d "{{ moodlebox_hostname }}.{{ moodlebox_tld }}"

echo "Copying PEM certificate and PRIV key to their respective dirs for MOODLEBOX"
install -C -m 600 -o "{{ moodlebox_webserver_user }}" -g "{{ moodlebox_webserver_user }}" \
  "$(pwd)/etc/live/{{ moodlebox_hostname }}.{{ moodlebox_tld }}/fullchain.pem" "{{ moodlebox_tls_cert_pem }}"
install -C -m 600 -o "{{ moodlebox_webserver_user }}" -g "{{ moodlebox_webserver_user }}" \
  "$(pwd)/etc/live/{{ moodlebox_hostname }}.{{ moodlebox_tld }}/privkey.pem" "{{ moodlebox_tls_key_pem }}"
