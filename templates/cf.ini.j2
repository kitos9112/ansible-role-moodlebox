# Cloudflare API credentials used by Certbot
{% if moodlebox_cf_api_token | default('') | trim | length > 0 %}
dns_cloudflare_api_token = {{ moodlebox_cf_api_token }}
{% else %}
dns_cloudflare_email = {{ moodlebox_cf_email_address | default(cloudflare_account_email | default('')) }}
dns_cloudflare_api_key = {{ moodlebox_cf_api_key | default(cloudflare_api_key | default('')) }}
{% endif %}
